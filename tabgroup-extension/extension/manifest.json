{
  "manifest_version": 3,
  "name": "Tab Group from CLI",
  "version": "1.0.2",
  "description": "Open any number of links in a named tab group with one terminal command.",
  "permissions": ["tabGroups", "storage"],
  "host_permissions": ["*://tabgroup.localhost/*"],
  "background": { "service_worker": "bg.js" },
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" }
}
