#!/usr/bin/env bash
# Usage: tabgroup [-c color] [-C] "Group name" url1 [url2 ...]
#   -c color  grey|blue|red|yellow|green|pink|purple|cyan|orange
#   -C        start collapsed
# Set CHROME to override the browser command.
set -euo pipefail

usage() { echo "Usage: tabgroup [-c color] [-C] \"Group name\" url1 [url2 ...]" >&2; exit 1; }

urlencode() {
  local LC_ALL=C s="$1" out="" c i
  for ((i = 0; i < ${#s}; i++)); do
    c="${s:i:1}"
    case "$c" in
      [a-zA-Z0-9.~_-]) out+="$c" ;;
      *) out+=$(printf '%%%02X' "'$c") ;;
    esac
  done
  printf '%s' "$out"
}

color="" collapsed=0
while getopts "c:C" opt; do
  case "$opt" in
    c) color="$OPTARG" ;;
    C) collapsed=1 ;;
    *) usage ;;
  esac
done
shift $((OPTIND - 1))
[ $# -ge 2 ] || usage

url="http://tabgroup.localhost/?name=$(urlencode "$1")"
shift
[ -n "$color" ] && url+="&color=$(urlencode "$color")"
[ "$collapsed" = 1 ] && url+="&collapsed=1"
for u in "$@"; do url+="&u=$(urlencode "$u")"; done

if [ -n "${CHROME:-}" ]; then
  "$CHROME" "$url" >/dev/null 2>&1 &
elif [ "$(uname)" = "Darwin" ]; then
  open -a "Google Chrome" "$url"
else
  for b in google-chrome google-chrome-stable chromium chromium-browser; do
    if command -v "$b" >/dev/null; then "$b" "$url" >/dev/null 2>&1 & exit 0; fi
  done
  echo "Chrome not found. Set CHROME=/path/to/chrome" >&2; exit 1
fi
